#include <16F877A.h>
#device ADC=10

#FUSES NOWDT, PUT, NOBROWNOUT, NOLVP
#use delay(crystal=4MHz)
#use i2c(Master,Fast,sda=PIN_C4,scl=PIN_C3)

#define LCD_ENABLE_PIN PIN_B0
#define LCD_RS_PIN PIN_B1
#define LCD_RW_PIN PIN_B2
#define LCD_DATA4 PIN_B3
#define LCD_DATA5 PIN_B4
#define LCD_DATA6 PIN_B5
#define LCD_DATA7 PIN_B6

#include <lcd.c>

#define bcd_to_dec(x)  (((x >> 4) * 10) + (x & 0x0F))

void main() {
   int sec, min, hrs;

   lcd_init();

   while(TRUE) {
      // Set DS1307 pointer to 0x00 (seconds register)
      i2c_start();
      i2c_write(0xD0);   // Write mode
      i2c_write(0x00);   // Start from register 0x00
      i2c_start();
      i2c_write(0xD1);   // Read mode

      sec = i2c_read(1);   // Read seconds, ACK
      min = i2c_read(1);   // Read minutes, ACK
      hrs = i2c_read(0);   // Read hours, NACK (last byte)
      i2c_stop();

      // Convert BCD to decimal
      sec = bcd_to_dec(sec);
      min = bcd_to_dec(min);
      hrs = bcd_to_dec(hrs);

      lcd_gotoxy(1,1);
      printf(lcd_putc,"\f%02d:%02d:%02d", hrs, min, sec);

      delay_ms(1000);
   }
}
