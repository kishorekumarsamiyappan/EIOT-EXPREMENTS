....................    lcd_output_enable(1); 
004F:  BCF    03.5
0050:  BSF    08.0
0051:  BSF    03.5
0052:  BCF    08.0
....................    delay_us(2); 
0053:  GOTO   054
....................    lcd_output_enable(0); 
0054:  BCF    03.5
0055:  BCF    08.0
0056:  BSF    03.5
0057:  BCF    08.0
0058:  BCF    03.5
0059:  RETURN
.................... } 
