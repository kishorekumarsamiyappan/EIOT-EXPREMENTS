#include <16F877A.h>
#device ADC=16

#FUSES NOWDT, PUT, NOBROWNOUT, NOLVP
#use delay(crystal=4MHz)

#define LCD_ENABLE_PIN PIN_B2
#define LCD_RS_PIN PIN_B0
#define LCD_RW_PIN PIN_B1
#define LCD_DATA4 PIN_B4
#define LCD_DATA5 PIN_B5
#define LCD_DATA6 PIN_B6
#define LCD_DATA7 PIN_B7
#include <lcd.c>

// Time variables
int seconds = 0, minutes = 0, hours = 0;

// Preload value for Timer1 to get ~1s interrupt
#define TMR1_PRELOAD 3036

#INT_TIMER1
void TIMER1_isr() {
   set_timer1(TMR1_PRELOAD); // Reload Timer1 for next 1s
   seconds++;
   if (seconds >= 60) {
      seconds = 0;
      minutes++;
      if (minutes >= 60) {
         minutes = 0;
         hours++;
         if (hours >= 24) {
            hours = 0;
         }
      }
   }
}

void display_time() {
   lcd_gotoxy(1, 1);
   printf(lcd_putc, "Time: %02u:%02u:%02u", hours, minutes, seconds);
}

void main() {
   lcd_init();

   // Timer1 setup: internal clock (Fosc/4), prescaler 1:8
   setup_timer_1(T1_INTERNAL | T1_DIV_BY_8);
   set_timer1(TMR1_PRELOAD);

   enable_interrupts(INT_TIMER1);
   enable_interrupts(GLOBAL);

   while (TRUE) {
      display_time();
      delay_ms(10); // Small delay to reduce flicker
   }
}
