#include <16F877A.h>
#device ADC=16

#FUSES NOWDT, PUT, NOBROWNOUT, NOLVP
#use delay(crystal=4MHz)
#use rs232(baud=9600, parity=N, xmit=PIN_C6, rcv=PIN_C7, bits=8, stream=PORT1, errors)

void main() {
   char c;

   output_low(PIN_B0);   

   while(TRUE) {
      if (kbhit(PORT1)) {      
         c = fgetc(PORT1);      
         if (c == '1') {
            output_high(PIN_B0);   
            printf("LED ON\r\n");
         }
         else if (c == '0') {
            output_low(PIN_B0);    
            printf("LED OFF\r\n");
         }
         else if(c == '2'){
          printf("LED BLINK\r\n");
          output_low(PIN_B0);
          delay_ms(100);
          output_high(PIN_B0); 
          delay_ms(100);
         }
         else 
         {
         printf("Undefined Coommand\r\n");
         }
      }
   }
}

